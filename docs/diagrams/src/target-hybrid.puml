@startuml
!include <C4/C4_Context>
title Target hybrid execution architecture - planned, external access enforcement
LAYOUT_TOP_DOWN()
Person(user, "Authorised workflow user", "Runs CWL workflows through a common interface.")
System(clients, "Client integrations [planned]", "Zoo-Project WES runner and common Python WES client.")
System_Ext(idp, "Common OIDC identity provider [planned integration]", "Issues access tokens and publishes token verification material.")
System_Ext(access, "External API gateway [planned integration]", "Validates JWTs and enforces namespace/operation access. Clients cannot bypass this layer.")
System_Ext(policy, "Policy engine, e.g. OPA [planned integration]", "Evaluates permissions. Trusted per-run ownership data remains to be designed.")
System(gateway, "WES Gateway [implemented foundation; planned extensions]", "Namespaced routing, WES forwarding and durable run associations. Planned: policy-based backend selection. No OIDC/RBAC enforcement.")
System_Ext(cloud, "Cloud execution domain [Kubernetes implemented]", "Independent Toil WES deployment backed by Kubernetes.")
System_Ext(hpc, "HPC execution domain [planned]", "Independent Toil WES deployment backed by SLURM or PBS Pro; namespace maps to partition/account.")
System(staging, "Execution and data middleware [planned]", "Resource/queue translation, temporary storage, input/output staging and provenance. Placement to be designed.")
System_Ext(data, "EOEPCA data spaces [planned integration]", "Source and destination datasets synchronised with execution storage.")
System(bridge, "Zoo-based ESA integration [planned]", "Submission and monitoring through ESA-approved access interfaces; topology to be agreed.")
System_Ext(esa, "ESA Space HPC [planned integration]", "Institutional compute and storage subject to ESA access and operational policies.")
Rel(user, clients, "Submits and monitors workflows")
Rel(clients, idp, "Obtains user access token", "OIDC / OAuth2")
Rel(clients, access, "Submits, inspects and cancels runs", "WES / JWT access token")
Rel(access, idp, "Uses issuer metadata and verification keys", "HTTPS")
Rel(access, policy, "Requests access decision using verified identity and route")
Rel(access, gateway, "Forwards permitted requests only", "Internal WES / HTTP(S)")
Rel(gateway, cloud, "Routes permitted cloud workloads", "WES / HTTP(S)")
Rel(gateway, hpc, "Routes permitted HPC workloads [planned]", "WES / HTTP(S)")
Rel(staging, cloud, "Coordinates data and execution requirements [planned]")
Rel(staging, hpc, "Coordinates data, queues and resource mapping [planned]")
Rel(staging, data, "Stages and synchronises inputs/outputs [planned]")
Rel(clients, bridge, "Uses ESA execution integration [planned]")
Rel(bridge, esa, "Submits and monitors with approved credentials [planned]")
Rel(staging, esa, "Transfers datasets with traceability [planned]")
SHOW_LEGEND()
@enduml
